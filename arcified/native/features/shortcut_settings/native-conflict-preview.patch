+AcceleratorChangePreview BrowserShortcutService::PreviewAcceleratorAssignment(
+    int command_id,
+    const std::string& serialized) const {
+  if (!HasCommand(command_id)) {
+    return {AssignmentResult::kUnknownCommand, {}};
+  }
+  std::optional<AcceleratorEntry> entry = EntryFromString(serialized, true);
+  if (!entry) {
+    return {AssignmentResult::kInvalidAccelerator, {}};
+  }
+
+  AcceleratorChangePreview preview;
+  preview.conflicts = FindShortcutConflicts(
+      command_id, current_, std::vector<AcceleratorEntry>{*entry},
+      ConflictScope::kAssignment);
+#if BUILDFLAG(IS_MAC)
+  // Locked platform defaults may have no Settings label/current_ entry.
+  for (const auto& platform_default : GetPlatformDefaultAccelerators()) {
+    if (platform_default.command_id != command_id &&
+        !platform_default.user_modifiable &&
+        platform_default.accelerator == entry->accelerator) {
+      AddShortcutConflict(preview.conflicts, platform_default.command_id, true);
+    }
+  }
+#endif
+  if (IsAcceleratorLocked(entry->accelerator, command_id)) {
+    preview.result = AssignmentResult::kShortcutLocked;
+  }
+  return preview;
+}
+
+AcceleratorChangePreview BrowserShortcutService::PreviewAcceleratorReset(
+    int command_id) const {
+  const auto defaults_it = defaults_.find(command_id);
+  if (defaults_it == defaults_.end()) {
+    return {AssignmentResult::kUnknownCommand, {}};
+  }
+  // Reset replaces the target with its defaults, then removes only modifiable
+  // collisions elsewhere. It does not use assignment's lock refusal.
+  return {AssignmentResult::kSuccess,
+          FindShortcutConflicts(command_id, current_, defaults_it->second,
+                                ConflictScope::kReset)};
+}
+
 AssignmentResult BrowserShortcutService::AssignAcceleratorToCommand(
     int command_id,
     const std::string& serialized) {
