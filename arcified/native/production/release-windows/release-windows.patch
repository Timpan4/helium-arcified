+// Arcified downstream changes: SPDX-License-Identifier: GPL-3.0-only.
+TEST_P(GetInstalledDirectoryTest, RejectsMalformedRegisteredSetupLayout) {
+  const base::FilePath install_path = random_path().Append(L"Existing install");
+  ASSERT_TRUE(base::CreateDirectory(install_path));
+  base::win::RegKey client_key(GetClientsRegKey());
+  ASSERT_EQ(client_key.WriteValue(google_update::kRegVersionField, L"1.0.0.0"),
+            ERROR_SUCCESS);
+  base::win::RegKey client_state_key(GetClientStateRegKey());
+
+  const wchar_t* const invalid_suffixes[] = {
+      L"1.0.0.0\\Installer\\other.exe",
+      L"1.0.0.0\\Other\\setup.exe",
+      L"not-a-version\\Installer\\setup.exe",
+      L"1.0.invalid.0\\Installer\\setup.exe",
+      L"Installer\\setup.exe",
+      L"1.0.0.0\\setup.exe",
+      L"setup.exe",
+  };
+  for (const wchar_t* suffix : invalid_suffixes) {
+    const base::FilePath setup_path = install_path.Append(suffix);
+    SCOPED_TRACE(setup_path.AsUTF8Unsafe());
+    ASSERT_EQ(client_state_key.WriteValue(kUninstallStringField,
+                                          setup_path.value().c_str()),
+              ERROR_SUCCESS);
+
+    EXPECT_TRUE(GetInstalledDirectory(is_system_level()).empty());
+    EXPECT_TRUE(base::DirectoryExists(install_path));
+  }
+}
+
+TEST_P(GetInstalledDirectoryTest, AcceptsCaseAndRegisteredVersionSkew) {
+  const base::FilePath install_path = random_path().Append(L"Existing install");
+  ASSERT_TRUE(base::CreateDirectory(install_path));
+  base::win::RegKey client_key(GetClientsRegKey());
+  ASSERT_EQ(client_key.WriteValue(google_update::kRegVersionField, L"1.0.0.0"),
+            ERROR_SUCCESS);
+  base::win::RegKey client_state_key(GetClientStateRegKey());
+  ASSERT_EQ(client_state_key.WriteValue(
+                kUninstallStringField,
+                install_path.Append(L"2.0.0.0\\iNsTaLlEr\\SeTuP.ExE")
+                    .value()
+                    .c_str()),
+            ERROR_SUCCESS);
+
+  // A valid registered layout need not match the Clients version. Interrupted
+  // updates and repair must not require the versioned setup file to exist here.
+  EXPECT_EQ(GetInstalledDirectory(is_system_level()), install_path);
+}
