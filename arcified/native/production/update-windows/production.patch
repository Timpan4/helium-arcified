diff --git a/chrome/browser/ui/webui/help/arcified_version_updater_win.cc b/chrome/browser/ui/webui/help/arcified_version_updater_win.cc
new file mode 100644
index 00000000..7e8dd344
--- /dev/null
+++ b/chrome/browser/ui/webui/help/arcified_version_updater_win.cc
@@ -0,0 +1,32 @@
+// Copyright 2026 The Helium Arcified Authors
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "chrome/browser/ui/webui/help/version_updater.h"
+
+#include <memory>
+#include <string>
+
+#include "chrome/grit/generated_resources.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace {
+
+// The unbranded Windows build has no approved authenticated update transport.
+// Keep the native About-page entry point available without interpreting an
+// installed-version notification as proof of an authenticated Arcified update.
+// This class does not fetch, stage, install, roll back, or request a restart.
+class ArcifiedVersionUpdaterWin final : public VersionUpdater {
+ public:
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    callback.Run(
+        DISABLED, 0, false, false, std::string(), 0,
+        l10n_util::GetStringUTF16(IDS_ARCIFIED_UPDATE_WINDOWS_UNAVAILABLE));
+    // The callback can destroy this updater. Do not access members afterward.
+  }
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(content::WebContents*) {
+  return std::make_unique<ArcifiedVersionUpdaterWin>();
+}
diff --git a/chrome/browser/ui/webui/help/arcified_version_updater_win_browsertest.cc b/chrome/browser/ui/webui/help/arcified_version_updater_win_browsertest.cc
new file mode 100644
index 00000000..bf3022e4
--- /dev/null
+++ b/chrome/browser/ui/webui/help/arcified_version_updater_win_browsertest.cc
@@ -0,0 +1,48 @@
+// Copyright 2026 The Helium Arcified Authors
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/grit/generated_resources.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace {
+
+using ArcifiedUpdateWindowsBrowserTest = InProcessBrowserTest;
+
+// Exercise the actual Settings WebUI -> AboutHandler -> VersionUpdater factory
+// -> WebUI event binding. No update service or VersionUpdater is substituted.
+IN_PROC_BROWSER_TEST_F(ArcifiedUpdateWindowsBrowserTest,
+                       AboutReportsUnavailableThroughNativeBinding) {
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://settings/help")));
+  auto* contents = browser()->tab_strip_model()->GetActiveWebContents();
+  EXPECT_EQ(l10n_util::GetStringUTF8(IDS_ARCIFIED_UPDATE_WINDOWS_UNAVAILABLE),
+            content::EvalJs(contents, R"JS(
+              (async () => {
+                const {addWebUiListener, removeWebUiListener} =
+                    await import('chrome://resources/js/cr.js');
+                return new Promise(resolve => {
+                  const listener = addWebUiListener(
+                      'update-status-changed', event => {
+                        removeWebUiListener(listener);
+                        resolve(event.status === 'disabled' &&
+                                        event.progress === 0 &&
+                                        !event.rollback && !event.powerwash &&
+                                        event.version === '' &&
+                                        event.size === '0' ?
+                                    event.message :
+                                    'Unexpected update status');
+                      });
+                  chrome.send('refreshUpdateStatus');
+                });
+              })()
+            )JS"));
+}
+
+}  // namespace
diff --git a/chrome/browser/ui/webui/help/arcified_version_updater_win_unittest.cc b/chrome/browser/ui/webui/help/arcified_version_updater_win_unittest.cc
new file mode 100644
index 00000000..f5975a6d
--- /dev/null
+++ b/chrome/browser/ui/webui/help/arcified_version_updater_win_unittest.cc
@@ -0,0 +1,68 @@
+// Copyright 2026 The Helium Arcified Authors
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "chrome/browser/ui/webui/help/version_updater.h"
+
+#include <cstdint>
+#include <string>
+
+#include "base/test/bind.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+TEST(ArcifiedVersionUpdaterWinTest, ReportsUnavailableWithoutOfferingMutation) {
+  auto updater = VersionUpdater::Create(nullptr);
+  int replies = 0;
+  bool promoted = false;
+  updater->CheckForUpdate(
+      base::BindLambdaForTesting(
+          [&](VersionUpdater::Status status, int progress, bool rollback,
+              bool powerwash, const std::string& version, int64_t size,
+              const std::u16string& message) {
+            ++replies;
+            EXPECT_EQ(VersionUpdater::DISABLED, status);
+            EXPECT_EQ(0, progress);
+            EXPECT_FALSE(rollback);
+            EXPECT_FALSE(powerwash);
+            EXPECT_TRUE(version.empty());
+            EXPECT_EQ(0, size);
+            EXPECT_FALSE(message.empty());
+          }),
+      base::BindLambdaForTesting(
+          [&](VersionUpdater::PromotionState) { promoted = true; }));
+  EXPECT_EQ(1, replies);
+  EXPECT_FALSE(promoted);
+}
+
+TEST(ArcifiedVersionUpdaterWinTest, CallbackCanDestroyUpdater) {
+  auto updater = VersionUpdater::Create(nullptr);
+  bool replied = false;
+  updater->CheckForUpdate(
+      base::BindLambdaForTesting([&](VersionUpdater::Status status, int, bool,
+                                     bool, const std::string&, int64_t,
+                                     const std::u16string&) {
+        EXPECT_EQ(VersionUpdater::DISABLED, status);
+        replied = true;
+        updater.reset();
+      }),
+      {});
+  EXPECT_TRUE(replied);
+  EXPECT_FALSE(updater);
+}
+
+TEST(ArcifiedVersionUpdaterWinTest, RepeatedRequestsStayUnavailable) {
+  auto updater = VersionUpdater::Create(nullptr);
+  int replies = 0;
+  auto callback = base::BindLambdaForTesting(
+      [&](VersionUpdater::Status status, int, bool, bool, const std::string&,
+          int64_t, const std::u16string&) {
+        EXPECT_EQ(VersionUpdater::DISABLED, status);
+        ++replies;
+      });
+  updater->CheckForUpdate(callback, {});
+  updater->CheckForUpdate(callback, {});
+  EXPECT_EQ(2, replies);
+}
+
+}  // namespace
